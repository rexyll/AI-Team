# AI-Team 环境配置模板
# 复制为 .env 后填写。所有变量均可选——完全不配置时回落 Agnes 默认路径。

# ── Provider 凭证（按需启用对应段）──────────────────────────
# Agnes（现有默认端点）
# AGNES_API_KEY=
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# AGNES_MODEL=agnes-2.5-flash

# OpenRouter（OpenAI 兼容聚合端点，模型 slug 见 openrouter.ai/models）
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# DeepSeek（官方直连，国内可直达无需代理）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── 全局默认 provider：agnes | openrouter ──────────────────
# DEFAULT_PROVIDER=openrouter

# ── 按角色覆盖模型（可选；不设则用所属 provider 的默认模型）──
# 变量名规则：{角色大写}_MODEL / {角色大写}_PROVIDER
# PLANNER_MODEL=stealth/ox-alpha
# ARCHITECT_MODEL=stealth/ox-alpha
# DEVELOPER_MODEL=stealth/ox-alpha
# TESTER_MODEL=stealth/ox-alpha
# REVIEWER_MODEL=stealth/ox-alpha
#
# 混合示例：Planner/Reviewer 用强模型，Tester 用便宜档
# PLANNER_MODEL=openai/gpt-4o
# REVIEWER_MODEL=anthropic/claude-3.5-sonnet
# TESTER_MODEL=google/gemini-flash-1.5
