# ================================================================
# AI-Dev-Team LLM configuration
# ================================================================
# Copy this file to .env and replace secrets / model identifiers.
# Runtime code contains no provider URL or model identifier defaults.
# ================================================================

# ----------------------------------------------------------------
# CONFIGURATION 1: ALL ROLES USE ONE MODEL
# ----------------------------------------------------------------
# This is the simplest configuration and is suitable for a baseline
# single-model benchmark.

LLM_PROVIDERS=agnes
DEFAULT_PROVIDER=agnes
DEFAULT_MODEL=agnes-2.5-flash

AGNES_API_KEY=your-agnes-api-key
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1/chat/completions
AGNES_MODEL=agnes-2.5-flash

# Optional: one or more Developers. Every Developer inherits the
# same DEVELOPER_MODEL / DEFAULT_MODEL unless overridden below.
DEVELOPER_COUNT=3
# DEVELOPER_1_MODEL=agnes-2.5-flash
# DEVELOPER_2_MODEL=agnes-2.5-flash
# DEVELOPER_3_MODEL=agnes-2.5-flash

# ----------------------------------------------------------------
# CONFIGURATION 2: DIFFERENT MODEL PER ROLE / DEVELOPER
# ----------------------------------------------------------------
# To use this mode, comment/remove the Configuration 1 bindings above
# and enable the settings below. Each provider must have its own API key
# and base URL when it is actually selected.

# LLM_PROVIDERS=agnes,deepseek
# DEFAULT_PROVIDER=agnes
# DEFAULT_MODEL=agnes-2.5-flash

# AGNES_API_KEY=your-agnes-api-key
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1/chat/completions
# AGNES_MODEL=agnes-2.5-flash

# DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# Role-specific model selection. Provider is optional when the role
# should use DEFAULT_PROVIDER.
# PLANNER_PROVIDER=agnes
# PLANNER_MODEL=agnes-2.5-flash
# ARCHITECT_PROVIDER=agnes
# ARCHITECT_MODEL=agnes-2.5-flash
# DEVELOPER_PROVIDER=deepseek
# DEVELOPER_MODEL=deepseek-v4-flash
# TESTER_PROVIDER=agnes
# TESTER_MODEL=agnes-2.5-flash
# REVIEWER_PROVIDER=deepseek
# REVIEWER_MODEL=deepseek-v4-flash

# ----------------------------------------------------------------
# MULTIPLE DEVELOPERS WITH DIFFERENT MODELS
# ----------------------------------------------------------------
# DEVELOPER_COUNT controls how many Developer agents are created.
# Each Developer can override both provider and model independently.
# Missing per-Developer values inherit DEVELOPER_PROVIDER / MODEL,
# then the selected provider's MODEL, then DEFAULT_MODEL.

# DEVELOPER_COUNT=3
# DEVELOPER_1_PROVIDER=agnes
# DEVELOPER_1_MODEL=agnes-2.5-flash
# DEVELOPER_2_PROVIDER=deepseek
# DEVELOPER_2_MODEL=deepseek-v4-flash
# DEVELOPER_3_PROVIDER=agnes
# DEVELOPER_3_MODEL=agnes-2.5-flash

# Optional generic Developer fallback:
# DEVELOPER_PROVIDER=agnes
# DEVELOPER_MODEL=agnes-2.5-flash

# ----------------------------------------------------------------
# Runtime / retry settings
# ----------------------------------------------------------------
# LLM_MAX_ATTEMPTS=4
# LLM_BACKOFF_SECONDS=2
# LLM_INVALID_VERDICT_ATTEMPTS=2
# REVIEWER_MAX_DEVELOPER_RESULT_CHARS=16000
