# ═══ .env：唯一的模型配置地 ═══

# ── 声明 provider（也可省略——凡是有 <X>_API_KEY 的自动发现）──
LLM_PROVIDERS=openrouter,deepseek,agnes

# ── 每个 provider 三件套 ──
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_API_KEY=...
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── 全局默认 ──
DEFAULT_PROVIDER=openrouter

# ── 按角色绑定模型（随时可改）──
PLANNER_MODEL=stealth/ox-alpha
ARCHITECT_MODEL=stealth/ox-alpha
DEVELOPER_MODEL=deepseek-v4-flash      # ← 换模型就改这里
TESTER_MODEL=stealth/ox-alpha
REVIEWER_MODEL=stealth/ox-alpha